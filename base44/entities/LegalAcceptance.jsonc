{
  "type": "object",
  "properties": {
    "terms_version": {
      "type": "string"
    },
    "privacy_version": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "acceptance_method": {
      "type": "string"
    }
  },
  "required": [
    "terms_version",
    "privacy_version",
    "accepted_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "LegalAcceptance"
}