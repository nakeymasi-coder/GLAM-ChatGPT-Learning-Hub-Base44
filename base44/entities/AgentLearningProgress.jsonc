{
  "name": "AgentLearningProgress",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "completed"
      ]
    },
    "saved": {
      "type": "boolean"
    }
  },
  "required": [
    "lesson_id",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}