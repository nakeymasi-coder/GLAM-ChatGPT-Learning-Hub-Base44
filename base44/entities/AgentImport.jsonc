{
  "name": "AgentImport",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "count": {
      "type": "number"
    },
    "summaries": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "source",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}